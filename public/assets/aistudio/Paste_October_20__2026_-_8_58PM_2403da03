                    <div class="mt-6 pt-4 border-t border-slate-800">
                        <h4 class="font-bold text-white text-sm mb-3">الباقات الحالية</h4>
                        <div id="adminPackagesList" class="space-y-2 max-h-48 overflow-y-auto"></div>

                { id: 501, name: 'بطاقة Google Play $10', category: 'PlayStation', price: 9.99, desc: 'متجر أمريكي / أوروبي' },
                { id: 502, name: 'بطاقة iTunes $15', category: 'Apple', price: 14.99, desc: 'متجر أبل ستور' },
                { id: 503, name: 'بطاقة Steam $20', category: 'Steam', price: 19.99, desc: 'شحن محفظة ستيم' }
            ],
            subscriptions: [
                { id: 601, name: 'اشتراك Netflix شهر (HD)', price: 3.99, period: 'شهر واحد' },
                { id: 602, name: 'اشتراك Shahid VIP شهر', price: 2.99, period: 'شهر واحد' }
            ],
            accounts: [
                { id: 701, name: 'حساب eFootball قوي جداً', price: 45.00, desc: 'تشكيلة إيبك كاملة + كاسياس وسواريز' },
                { id: 702, name: 'حساب PUBG قديم ميثيك', price: 79.99, desc: 'مشحون من السيزون 6 + أسلحة متطورة' }
            ]
        };

        let appData = JSON.parse(localStorage.getItem('dzairpay_data')) || defaultData;
        let selectedGameId = 'efootball';
        let userBalance = parseFloat(localStorage.getItem('dzairpay_balance')) || 25.00;
        let activeItemToBuy = null;

        function saveState() {
            localStorage.setItem('dzairpay_data', JSON.stringify(appData));
            localStorage.setItem('dzairpay_balance', userBalance.toString());
        }

        function formatPrice(price) {
            return `${parseFloat(price).toFixed(2)} €`;
        }

        function renderHeader() {
            document.getElementById('userBalance').innerText = formatPrice(userBalance);
        }

        function renderGameTabs() {
            const container = document.getElementById('gamesTabs');
            if (!container) return;
            container.innerHTML = appData.games.map(game => `
                <button onclick="selectGame('${game.id}')" class="p-3 rounded-2xl border transition flex items-center gap-3 text-right ${selectedGameId === game.id ? 'bg-purple-900/60 border-purple-500 shadow-lg text-white' : 'bg-slate-800/80 border-slate-700 text-gray-300 hover:border-slate-500'}">
                    <div class="w-10 h-10 rounded-xl bg-gradient-to-br ${game.color} flex items-center justify-center text-white text-lg">
                        <i class="fas ${game.icon}"></i>
                    </div>
                    <div class="flex-grow">
                        <span class="font-bold text-sm block">${game.name}</span>
                        <span class="text-[10px] text-emerald-400 font-semibold">${game.tag || 'شحن فوري'}</span>
                    </div>
                </button>
            `).join('');
        }

        function selectGame(id) {
            selectedGameId = id;
            renderGameTabs();
            renderPackages();
        }

        function renderPackages() {
            const container = document.getElementById('packagesContainer');
            if (!container) return;

            const filtered = appData.packages.filter(p => p.gameId === selectedGameId);
            if (filtered.length === 0) {
                container.innerHTML = `<div class="col-span-full text-center py-8 text-gray-400">لا توجد حزم متاحة حالياً لهذه اللعبة</div>`;
                return;
            }

            container.innerHTML = filtered.map(pkg => `
                <div class="bg-slate-800/90 rounded-xl border ${pkg.popular ? 'border-amber-500/80 shadow-lg' : 'border-slate-700'} p-4 flex flex-col justify-between hover:border-purple-500 transition-all relative overflow-hidden group">
                    ${pkg.popular ? '<span class="absolute top-0 left-0 bg-amber-500 text-slate-950 font-bold text-[10px] px-2 py-0.5 rounded-br-lg">الأكثر مبيعاً</span>' : ''}
                    <div class="mb-3">
                        <div class="flex items-center gap-3 mb-2">
                            <div class="w-10 h-10 rounded-lg bg-purple-900/50 flex items-center justify-center text-purple-400 border border-purple-500/20">
                                <i class="fas fa-coins text-lg"></i>
                            </div>
                            <div>
                                <h4 class="font-bold text-white text-sm group-hover:text-purple-300 transition">${pkg.name}</h4>
                                <span class="text-xs text-gray-400">شحن فوري بالمعرف (ID)</span>
                            </div>
                        </div>
                    </div>
                    <div class="flex items-center justify-between mt-2 pt-2 border-t border-slate-700/60">
                        <div>
                            <span class="text-xs text-gray-400 block">السعر:</span>
                            <span class="font-extrabold text-emerald-400 text-base">${formatPrice(pkg.price)}</span>
                        </div>
                        <button onclick="openPurchaseModal('${pkg.name}', ${pkg.price})" class="bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 text-white text-xs font-bold px-3 py-2 rounded-lg transition shadow-md flex items-center gap-1">
                            <span>شحن الآن</span>
                            <i class="fas fa-bolt text-yellow-300"></i>
                        </button>
                    </div>
                </div>
            `).join('');
        }

        function renderCards() {
            const container = document.getElementById('cardsContainer');
            if (!container) return;
            container.innerHTML = appData.cards.map(card => `
                <div class="bg-slate-800/80 rounded-xl border border-slate-700 p-4 hover:border-purple-500 transition flex flex-col justify-between">
                    <div>
                        <div class="flex justify-between items-start mb-2">
                            <h4 class="font-bold text-white text-sm">${card.name}</h4>
                            <span class="bg-purple-900/60 text-purple-300 text-[10px] px-2 py-0.5 rounded border border-purple-500/30">${card.category}</span>
                        </div>
                        <p class="text-xs text-gray-400 mb-3">${card.desc}</p>
                    </div>
                    <div class="flex items-center justify-between pt-2 border-t border-slate-700">
                        <span class="font-bold text-emerald-400 text-sm">${formatPrice(card.price)}</span>
                        <button onclick="openPurchaseModal('${card.name}', ${card.price})" class="bg-slate-700 hover:bg-purple-600 text-white text-xs px-3 py-1.5 rounded-lg transition">شراء</button>
                    </div>
                </div>
            `).join('');
        }

        function renderSubscriptions() {
            const container = document.getElementById('subsContainer');
            if (!container) return;
            container.innerHTML = appData.subscriptions.map(sub => `
                <div class="bg-slate-800/80 rounded-xl border border-slate-700 p-4 hover:border-purple-500 transition flex flex-col justify-between">
                    <div>
                        <h4 class="font-bold text-white text-sm mb-1">${sub.name}</h4>
                        <span class="text-xs text-purple-400 bg-purple-900/30 px-2 py-0.5 rounded inline-block mb-3">${sub.period}</span>
                    </div>
                    <div class="flex items-center justify-between pt-2 border-t border-slate-700">
                        <span class="font-bold text-emerald-400 text-sm">${formatPrice(sub.price)}</span>
                        <button onclick="openPurchaseModal('${sub.name}', ${sub.price})" class="bg-slate-700 hover:bg-purple-600 text-white text-xs px-3 py-1.5 rounded-lg transition">اشتراك</button>
                    </div>
                </div>
            `).join('');
        }

        function renderAccounts() {
            const container = document.getElementById('accountsContainer');
            if (!container) return;
            container.innerHTML = appData.accounts.map(acc => `
                <div class="bg-slate-800/80 rounded-xl border border-slate-700 p-4 hover:border-purple-500 transition flex flex-col justify-between">
                    <div>
                        <h4 class="font-bold text-white text-sm mb-2">${acc.name}</h4>
                        <p class="text-xs text-gray-400 mb-3">${acc.desc}</p>
                    </div>
                    <div class="flex items-center justify-between pt-2 border-t border-slate-700">
                        <span class="font-bold text-emerald-400 text-sm">${formatPrice(acc.price)}</span>
                        <button onclick="openPurchaseModal('${acc.name}', ${acc.price})" class="bg-slate-700 hover:bg-purple-600 text-white text-xs px-3 py-1.5 rounded-lg transition">شراء الحساب</button>
                    </div>
                </div>
            `).join('');
        }

        /* Modal Purchase Functions */
        function openPurchaseModal(name, price) {
            activeItemToBuy = { name, price };
            document.getElementById('modalTitle').innerText = name;
            document.getElementById('modalPrice').innerText = formatPrice(price);
            document.getElementById('playerIdInput').value = '';
            document.getElementById('modalMsg').classList.add('hidden');
            document.getElementById('purchaseModal').classList.remove('hidden');
        }

        function closePurchaseModal() {
            document.getElementById('purchaseModal').classList.add('hidden');
        }

        function processPurchase() {
            const playerId = document.getElementById('playerIdInput').value.trim();
            const msgEl = document.getElementById('modalMsg');

            if (!playerId) {
                msgEl.innerText = "يرجى كتابة الـ ID أولاً!";
                msgEl.className = "text-xs font-bold mb-3 p-2.5 rounded-xl bg-red-900/50 text-red-300 border border-red-500/30";
                msgEl.classList.remove('hidden');
                return;
            }

            if (userBalance < activeItemToBuy.price) {
                msgEl.innerText = "رصيدك غير كافٍ! يرجى شحن حسابك من لوحة التحكم.";
                msgEl.className = "text-xs font-bold mb-3 p-2.5 rounded-xl bg-amber-900/50 text-amber-300 border border-amber-500/30";
                msgEl.classList.remove('hidden');
                return;
            }

            userBalance -= activeItemToBuy.price;
            saveState();
            renderHeader();

            msgEl.innerText = `تم الشحن بنجاح لـ ${playerId}! تم خصم ${formatPrice(activeItemToBuy.price)}`;
            msgEl.className = "text-xs font-bold mb-3 p-2.5 rounded-xl bg-emerald-900/50 text-emerald-300 border border-emerald-500/30";
            msgEl.classList.remove('hidden');

            setTimeout(() => {
                closePurchaseModal();
            }, 2000);
        }

        /* Admin Functions */
        function openAdminModal() {
            document.getElementById('adminModal').classList.remove('hidden');
        }

        function closeAdminModal() {
            document.getElementById('adminModal').classList.add('hidden');
        }

        function verifyAdminPassword() {
            const pwd = document.getElementById('adminPasswordInput').value;
            if (pwd === '2009') {
                document.getElementById('adminLoginSection').classList.add('hidden');
                document.getElementById('adminDashboardSection').classList.remove('hidden');
                renderAdminPackages();
            } else {
                document.getElementById('adminErrorMsg').classList.remove('hidden');
            }
        }

        function switchAdminTab(tab) {
            document.getElementById('adminTabPackages').classList.add('hidden');
            document.getElementById('adminTabBalance').classList.add('hidden');
            document.getElementById('adminTabGeneral').classList.add('hidden');

            document.getElementById('tabBtnPackages').className = "pb-2 border-b-2 border-transparent text-gray-400 hover:text-white";
            document.getElementById('tabBtnBalance').className = "pb-2 border-b-2 border-transparent text-gray-400 hover:text-white";
            document.getElementById('tabBtnGeneral').className = "pb-2 border-b-2 border-transparent text-gray-400 hover:text-white";

            if (tab === 'packages') {
                document.getElementById('adminTabPackages').classList.remove('hidden');
                document.getElementById('tabBtnPackages').className = "pb-2 border-b-2 border-purple-500 text-purple-400";
            } else if (tab === 'balance') {
                document.getElementById('adminTabBalance').classList.remove('hidden');
                document.getElementById('tabBtnBalance').className = "pb-2 border-b-2 border-purple-500 text-purple-400";
            } else {
                document.getElementById('adminTabGeneral').classList.remove('hidden');
                document.getElementById('tabBtnGeneral').className = "pb-2 border-b-2 border-purple-500 text-purple-400";
            }
        }

        function renderAdminPackages() {
            const container = document.getElementById('adminPackagesList');
            container.innerHTML = appData.packages.map((pkg) => `
                <div class="flex items-center justify-between bg-slate-800 p-2.5 rounded-xl border border-slate-700 text-xs">
                    <div>
                        <span class="font-bold text-white">${pkg.name}</span>
                        <span class="text-purple-400 mr-2">(${pkg.gameId})</span>
                    </div>
                    <div class="flex items-center gap-3">
                        <span class="font-bold text-emerald-400">${formatPrice(pkg.price)}</span>
                        <button onclick="deletePackage(${pkg.id})" class="text-red-400 hover:text-red-300">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    </div>
                </div>
            `).join('');
        }

        function addNewPackage() {
            const gameId = document.getElementById('adminGameSelect').value;
            const name = document.getElementById('adminPkgName').value.trim();
            const price = parseFloat(document.getElementById('adminPkgPrice').value);

            if (!name || isNaN(price)) {
                alert('يرجى ملء كافة معلومات الباقة بأسلوب صحيح!');
                return;
            }

            const newPkg = { id: Date.now(), gameId, name, price, popular: false };
            appData.packages.push(newPkg);
            saveState();
            renderPackages();
            renderAdminPackages();

            document.getElementById('adminPkgName').value = '';
            document.getElementById('adminPkgPrice').value = '';
        }

        function deletePackage(id) {
            appData.packages = appData.packages.filter(p => p.id !== id);
            saveState();
            renderPackages();
            renderAdminPackages();
        }

        function addBalanceAdmin() {
            const amount = parseFloat(document.getElementById('adminAddBalanceInput').value);
            if (!isNaN(amount) && amount > 0) {
                userBalance += amount;
                saveState();
                renderHeader();
                alert(`تم شحن ${formatPrice(amount)} لحسابك بنجاح!`);
                document.getElementById('adminAddBalanceInput').value = '';
            }
        }

        function saveGeneralSettings() {
            const phone = document.getElementById('cfgStorePhone').value;
            const email = document.getElementById('cfgStoreEmail').value;

            document.getElementById('displayTopPhone').innerText = phone;
            document.getElementById('displayTopEmail').innerText = email;
            document.getElementById('displayFooterPhone').innerText = phone;
            document.getElementById('displayFooterEmail').innerText = email;

            alert('تم حفظ إعدادات التواصل بنجاح!');
        }

        // Initialize App
        renderHeader();
        renderGameTabs();
        renderPackages();
        renderCards();
        renderSubscriptions();
        renderAccounts();
    </script>
</body>
</html>
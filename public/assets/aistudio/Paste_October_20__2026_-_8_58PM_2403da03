    <!-- Modal Purchase (نافذة الشراء) -->
    <div id="purchaseModal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="bg-slate-900 border border-slate-700 rounded-3xl max-w-md w-full p-6 shadow-2xl relative text-right text-white">
            <button onclick="closePurchaseModal()" class="absolute top-4 left-4 text-gray-400 hover:text-white w-8 h-8 rounded-full bg-slate-800 flex items-center justify-center">
                <i class="fa-solid fa-xmark"></i>
            </button>
            
            <div id="modalContent">
                <h3 id="modalTitle" class="text-xl font-black mb-2 text-purple-400"></h3>
                <p class="text-xs text-gray-400 mb-4">أدخل بيانات الحساب لإتمام العملية بسرعة وسلاسة.</p>
                
                <div class="mb-4">
                    <label class="block text-xs font-bold mb-1 text-gray-300">آيدي الحساب (Player ID / Email):</label>
                    <input type="text" id="playerIdInput" placeholder="أدخل ID الخاص بك" class="w-full p-3 bg-slate-800 border border-slate-700 rounded-xl text-sm text-white focus:outline-none focus:border-purple-500">
                </div>

                <div class="bg-slate-800/80 p-3 rounded-xl mb-4 flex justify-between items-center text-sm border border-slate-700">
                    <span class="text-gray-400">المبلغ المطلوب:</span>
                    <span id="modalPrice" class="font-black text-emerald-400 text-base"></span>
                </div>

                <div id="modalMsg" class="hidden text-xs font-bold mb-3 p-2.5 rounded-xl"></div>

                <button onclick="processPurchase()" class="w-full bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 text-white font-bold py-3 rounded-xl transition shadow-lg">
                    تأكيد الشراء الآن
                </button>
            </div>
        </div>
    </div>


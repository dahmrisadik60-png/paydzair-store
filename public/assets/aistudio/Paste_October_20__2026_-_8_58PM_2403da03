                    </div>
                </div>

                <!-- Admin Tab: General -->
                <div id="adminTabGeneral" class="space-y-4 hidden">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-bold text-gray-400 mb-1">رقم الهاتف</label>
                            <input type="text" id="cfgStorePhone" class="w-full p-2.5 bg-slate-800 border border-slate-700 rounded-xl text-sm font-bold text-white" value="0770-99-16-99">
